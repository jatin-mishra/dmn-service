# Base URL the browser uses for backend calls.
# Default "/api" goes through the Vite dev proxy (needed because the backend has no CORS config).
# Set to the full backend URL only if the backend serves CORS headers for this origin.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api requests (dev server only, not exposed to the browser).
BACKEND_URL=http://localhost:9090
